{
    "obs_dir_prefix": "obs_",
    "state_file": "state_measurements.csv",
    "los_file": "los_measurements.csv",
    "rso_truth_file": "rso_states.csv",

    "load_truth": true,
    "target_rso": "deb_perp",
    "max_vmag": 8,
    "filter_observers": ["cam1", "cam2", "cam3", "cam4", "cam5"],

    "init_date": "2000-01-01T11:59:28",

    "ukf_alpha": 0.01,
    "ukf_beta": 2.0,
    "ukf_kappa": 0.0,

    "initial_position_sigma_km": [100.0, 100.0, 100.0],
    "initial_velocity_sigma_km_s": [0.1, 0.1, 0.1],

    "observer_position_sigma_km": [0.5, 0.5, 0.5], 
    "observer_velocity_sigma_km_s": [0.0005, 0.0005, 0.0005],

    "los_sigma_arcsec": 42.43,

    "process_noise_enabled": true,
    "process_accel_sigma_km_s2": [1e-8, 1e-8, 1e-8],

    "covariance_jitter": 1e-12,

    "accuracy_threshold_km": 5,
    "velocity_threshold_ms": 10,

    "plot_results": true,
    "save_detailed_csv": true,
    "save_summary_csv": true
}